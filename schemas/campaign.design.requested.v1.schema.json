{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codestra.agency/campaign.design.requested.v1.schema.json",
  "title": "campaign.design.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "integration_uuid",
    "odoo_campaign_id",
    "environment",
    "business_unit",
    "purpose",
    "direction",
    "owner_user_id",
    "supervisor_user_id",
    "correlation_id"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "integration_uuid": {"type": "string", "format": "uuid"},
    "odoo_campaign_id": {"type": "integer", "minimum": 1},
    "environment": {"enum": ["staging", "test"]},
    "business_unit": {
      "enum": ["MOY", "COD", "SCP", "MBL", "RLP", "FTP", "TRX", "CAL", "TEST"]
    },
    "purpose": {"type": "string", "pattern": "^[A-Z0-9]{2,16}$"},
    "direction": {"enum": ["inbound", "outbound", "blended"]},
    "owner_user_id": {"type": "integer", "minimum": 1},
    "supervisor_user_id": {"type": "integer", "minimum": 1},
    "correlation_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "design_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_zone",
        "calling_hour_start",
        "calling_hour_end",
        "consent_required",
        "dnc_enforced",
        "team_ids",
        "supervisor_ids"
      ],
      "properties": {
        "time_zone": {"type": "string", "minLength": 1, "maxLength": 64},
        "calling_hour_start": {"type": "number", "minimum": 0, "exclusiveMaximum": 24},
        "calling_hour_end": {"type": "number", "exclusiveMinimum": 0, "maximum": 24},
        "consent_required": {"type": "boolean"},
        "dnc_enforced": {"type": "boolean"},
        "team_ids": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        },
        "supervisor_ids": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
