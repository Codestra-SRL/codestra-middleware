{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codestra.internal/recording/recording-event-v1.json",
  "title": "Verified recording event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "event_id", "event_type", "occurred_at", "environment", "recording_uid", "call_uid", "campaign_key", "sha256", "object_version_id", "retention_class"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "vicidial.recording.verified.v1"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "environment": {"type": "string"},
    "recording_uid": {"type": "string"},
    "call_uid": {"type": "string"},
    "campaign_key": {"type": "string"},
    "duration_seconds": {"type": ["number", "null"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_version_id": {"type": "string"},
    "retention_class": {"type": "string"}
  }
}
