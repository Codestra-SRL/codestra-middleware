{
  "$defs": {
    "Environment": {
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ],
      "title": "Environment",
      "type": "string"
    },
    "PiiClassification": {
      "enum": [
        "NONE",
        "INTERNAL",
        "PERSONAL",
        "SENSITIVE",
        "REGULATED"
      ],
      "title": "PiiClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_type": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Aggregate Type",
      "type": "string"
    },
    "business_unit_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Business Unit Id",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$",
      "title": "Event Type",
      "type": "string"
    },
    "event_version": {
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "organization_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Organization Id",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "pii_classification": {
      "$ref": "#/$defs/PiiClassification"
    },
    "policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "producer_identity": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Producer Identity",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": "codestra.event.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_system": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Source System",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "event_version",
    "idempotency_key",
    "correlation_id",
    "organization_id",
    "business_unit_id",
    "campaign_id",
    "aggregate_type",
    "aggregate_id",
    "source_system",
    "producer_identity",
    "environment",
    "policy_hash",
    "occurred_at",
    "recorded_at",
    "payload_hash",
    "pii_classification",
    "payload"
  ],
  "title": "CommonEventEnvelope",
  "type": "object"
}
