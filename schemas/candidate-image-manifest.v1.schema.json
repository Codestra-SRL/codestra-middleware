{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestra.internal/schemas/candidate-image-manifest.v1.json",
  "title": "Codestra candidate image manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "repository", "pr_number", "head_sha",
    "image_repository", "image_digest", "workflow_run_id",
    "workflow_run_attempt", "created_utc", "candidate_scope", "artifacts",
    "production_deployment_gate", "production_activation_gate"
  ],
  "properties": {
    "$schema": {"const": "https://codestra.internal/schemas/candidate-image-manifest.v1.json"},
    "schema_version": {"const": "1.0"},
    "repository": {"const": "Codestra-SRL/codestra-middleware"},
    "pr_number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "image_repository": {"const": "ghcr.io/codestra-srl/codestra-middleware"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "workflow_run_attempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "created_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "candidate_scope": {"const": "server_a_isolated_staging_candidate"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sbom", "provenance", "trivy", "grype"],
      "properties": {
        "sbom": {"$ref": "#/$defs/artifact"},
        "provenance": {"$ref": "#/$defs/artifact"},
        "trivy": {"$ref": "#/$defs/artifact"},
        "grype": {"$ref": "#/$defs/artifact"}
      }
    },
    "production_deployment_gate": {"const": "blocked"},
    "production_activation_gate": {"const": "blocked"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256"],
      "properties": {
        "reference": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
