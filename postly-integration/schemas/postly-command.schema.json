{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://codestra.co/schemas/postly-command-v1.json","title":"PostlyCommand","type":"object","additionalProperties":false,
  "required":["event_id","correlation_id","idempotency_key","organization_id","workspace_id","campaign_id","content_job_id","content_version","approval_id","approved_by","approved_at","integration_ids","scheduled_at","preferred_language","operation"],
  "properties":{
    "event_id":{"type":"string","format":"uuid"},"correlation_id":{"type":"string","minLength":1,"maxLength":128},"idempotency_key":{"type":"string","minLength":16,"maxLength":256},
    "organization_id":{"type":"string","minLength":1},"workspace_id":{"type":"string","minLength":1},"campaign_id":{"type":"string","minLength":1},"content_job_id":{"type":"string","minLength":1},"content_version":{"type":"integer","minimum":1},
    "approval_id":{"type":"string","minLength":1},"approved_by":{"type":"string","minLength":1},"approved_at":{"type":"string","format":"date-time"},"integration_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "scheduled_at":{"type":"string","format":"date-time"},"preferred_language":{"type":"string","enum":["en","es","fr","ht"]},
    "operation":{"enum":["list_integrations","get_integration_settings","find_slot","upload_media","schedule_post","get_post","list_posts","cancel_post","account_analytics","post_analytics","reconcile_release_id"]},
    "payload":{"type":"object"}
  }
}
