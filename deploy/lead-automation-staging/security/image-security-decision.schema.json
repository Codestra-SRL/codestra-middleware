{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "decision_subject", "middleware_source_sha", "odoo_source_sha", "image_manifest_sha256", "production_deployment_gate", "production_activation_gate", "server_b_access_gate", "customer_data_gate", "created_at_utc", "updated_at_utc", "security_owner_acceptance_present", "approved_scope", "approved_head_sha", "approved_image_digests", "issued_utc", "expires_utc", "signer_identity", "detached_signature_path", "security_owner", "security_owner_authority_reference", "decision_timestamp_utc", "expiration_timestamp_utc", "approval_reference", "accepted_image_digests", "accepted_vulnerability_counts", "required_compensating_controls", "revocation_conditions", "external_human_approval_required", "document_is_not_external_approval"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["security_owner_decision_required", "approved_for_staging"]},
    "decision_subject": {"type": "string", "minLength": 1},
    "middleware_source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "odoo_source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "image_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "production_deployment_gate": {"const": "blocked"},
    "production_activation_gate": {"const": "blocked"},
    "server_b_access_gate": {"const": "blocked"},
    "customer_data_gate": {"const": "blocked"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "security_owner_acceptance_present": {"type": "boolean"},
    "approved_scope": {"type": ["string", "null"]},
    "approved_head_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
    "approved_image_digests": {"type": ["object", "null"]},
    "issued_utc": {"type": ["string", "null"], "format": "date-time"},
    "expires_utc": {"type": ["string", "null"], "format": "date-time"},
    "signer_identity": {"type": ["string", "null"]},
    "detached_signature_path": {"type": ["string", "null"]},
    "security_owner": {"type": ["string", "null"]},
    "security_owner_authority_reference": {"type": ["string", "null"]},
    "decision_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "expiration_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "approval_reference": {"type": ["string", "null"]},
    "accepted_image_digests": {"type": ["object", "null"]},
    "accepted_vulnerability_counts": {"type": ["object", "null"]},
    "required_compensating_controls": {"type": ["array", "null"]},
    "revocation_conditions": {"type": ["array", "null"]},
    "external_human_approval_required": {"const": true},
    "document_is_not_external_approval": {"const": true}
  }
}
