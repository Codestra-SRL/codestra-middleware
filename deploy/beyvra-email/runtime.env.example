BEYVRA_EMAIL_DATABASE_URL_FILE=/run/secrets/database_url
BEYVRA_EMAIL_ISSUER=https://auth.codestra.agency/realms/codestra
BEYVRA_EMAIL_AUDIENCE=codestra-email
BEYVRA_EMAIL_JWKS_URL=https://auth.codestra.agency/realms/codestra/protocol/openid-connect/certs
BEYVRA_PROVIDER_WEBHOOK_SECRET_FILE=/run/secrets/provider_webhook_secret
POSTAL_WEBHOOK_SECRET_FILE=/run/secrets/postal_webhook_secret
POSTAL_WEBHOOK_TOKEN_FILE=/run/secrets/postal_webhook_token
KLYROW_TOKEN_FILE=/run/secrets/klyrow_token
KLYROW_SEND_URL=https://klyrow.internal.codestra.agency/v1/internal/email/send
KLYROW_CA_FILE=/run/mtls/klyrow/root-ca.crt
KLYROW_CERT_FILE=/run/mtls/klyrow/client-fullchain.crt
KLYROW_KEY_FILE=/run/mtls/klyrow/client.key
LIVE_EMAIL_DELIVERY=false
