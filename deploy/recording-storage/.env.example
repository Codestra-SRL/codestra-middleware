MINIO_ROOT_USER_FILE=/run/secrets/minio_root_user
MINIO_ROOT_PASSWORD_FILE=/run/secrets/minio_root_password
RECORDING_BUCKET=codestra-recordings-staging
STAGING_ENCRYPTION_MODE=SSE-S3
DEFAULT_RETENTION_DAYS=365
PRODUCTION_EXTERNAL_KMS_REQUIRED=true
PRODUCTION_KMS_PROVIDER=
RETENTION_DELETE_ENABLED=false
EXPORT_UPLOAD_ENABLED=false
ODOO_RECORDING_WRITE_ENABLED=false
N8N_RECORDING_WORKFLOW_ENABLED=false
