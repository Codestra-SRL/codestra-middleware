{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["exceptions"],
  "properties": {
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "scope", "environment", "image_digest", "repository", "expires", "cves", "justification", "compensating_controls", "reviewers", "approval"],
        "properties": {
          "id": {"type": "string", "minLength": 8},
          "owner": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "environment": {"const": "staging"},
          "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "repository": {"type": "string", "minLength": 3},
          "expires": {"type": "string", "format": "date-time"},
          "cves": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "justification": {"type": "string", "minLength": 20},
          "compensating_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reviewers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reviewer", "approved_at"],
            "properties": {
              "status": {"const": "accepted"},
              "reviewer": {"type": "string", "minLength": 1},
              "approved_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
