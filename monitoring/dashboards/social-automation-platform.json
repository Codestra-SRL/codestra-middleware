{"title":"Codestra Social Automation Platform","uid":"codestra-social-automation","schemaVersion":39,"version":1,"refresh":"30s","tags":["codestra","social","n8n"],"templating":{"list":[]},"panels":[{"id":1,"type":"timeseries","title":"Workflow outcomes","targets":[{"expr":"sum by (workflow, result) (rate(codestra_n8n_workflow_results_total[5m]))","legendFormat":"{{workflow}} {{result}}"}]},{"id":2,"type":"timeseries","title":"Provider health components","targets":[{"expr":"social_provider_health_score","legendFormat":"{{provider}} {{component}}"}]},{"id":3,"type":"timeseries","title":"Dead letters","targets":[{"expr":"increase(social_n8n_delivery_deadletter_total[15m])","legendFormat":"{{reason}}"}]},{"id":4,"type":"timeseries","title":"AI requests","targets":[{"expr":"sum by (provider, model, task, result) (rate(ai_requests_total[5m]))","legendFormat":"{{provider}} {{model}} {{task}} {{result}}"}]},{"id":5,"type":"stat","title":"Workflow drift","targets":[{"expr":"max(codestra_n8n_workflow_drift)","legendFormat":"drift"}]},{"id":6,"type":"timeseries","title":"Campaign transitions","targets":[{"expr":"sum by (old_state, new_state, result) (rate(social_campaign_transitions_total[5m]))","legendFormat":"{{old_state}} to {{new_state}} {{result}}"}]}]}
